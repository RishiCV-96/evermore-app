{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development"
    },
    "preview": {
      "distribution": "internal",
      "environment": "preview"
    },
    "production": {
      "distribution": "store",
      "environment": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_LOCAL_ONLY": "0"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6835703238",
        "appleTeamId": "1286279087"
      }
    }
  }
}