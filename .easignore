# What an EAS upload must never include. EAS reads this file instead of .gitignore, so it repeats
# .gitignore's rules and adds the user's real family. CLAUDE.md: never run `eas build` or
# `eas update` (both upload the project); this is a second line of defence.
# scripts/check-release.mjs checks that these lines are here.

# The user's real family: their photos, their cards (the local deck) and the private denylist.
# Development builds only, never committed (.gitignore), never uploaded.
assets/photos/*
!assets/photos/README.md
src/data/deck.local.ts
scripts/private-denylist.local.txt
*.local.ts
*.local.txt
*.local.md

# Secrets and local settings: every .env file (production values included), except the empty example
.env
.env.*
.env*.local
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision

# Native folders: Continuous Native Generation makes them on the builder (as in .gitignore)
/ios
/android
example

# Dependencies, builds and caches
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.kotlin/
*.orig.*
.metro-health-check*
npm-debug.*
yarn-debug.*
yarn-error.*
.DS_Store
*.tsbuildinfo

# Tests and fixtures: not part of the app
supabase/tests/
scripts/fakes/

# Documentation screenshots: large (about 16 MB) and not part of the app
docs/ui-polish-screenshots/
docs/brand-screenshots/
docs/person-home-screenshots/
docs/family-board-tab-screenshots/
